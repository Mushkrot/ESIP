# ESIP local reference configuration
# Copy to .env for local development. Keep all real credentials outside the repository.

# Credential-free local runtime. Use "connected" only when provider adapters
# have been configured intentionally.
RUNTIME_PROFILE=reference

# Public helpdesk adapter (optional)
ZENDESK_SUBDOMAIN=example
ZENDESK_EMAIL=alex.morgan@northstar.example.com
ZENDESK_API_TOKEN=

# Google Cloud connected adapters (optional)
GOOGLE_CLOUD_PROJECT_ID=esip-reference-project
GOOGLE_APPLICATION_CREDENTIALS=

# Local application
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_EMAIL_DOMAINS=northstar.example.com

# Notifications are disabled by default
EMAIL_TRANSPORT=disabled
GMAIL_SENDER_EMAIL=morgan.chen@northstar.example.com
GMAIL_SENDER_NAME=ESIP Notifications
GMAIL_DELEGATED_SUBJECT=
EMAIL_SENDGRID_FALLBACK_ENABLED=false
ALERT_FROM_EMAIL=morgan.chen@northstar.example.com
